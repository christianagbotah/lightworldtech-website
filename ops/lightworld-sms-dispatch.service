[Unit]
Description=Lightworld scheduled SMS dispatcher
After=network-online.target lightworldtech-app.service
Wants=network-online.target lightworldtech-app.service

[Service]
Type=oneshot
User=lightworld
Group=lightworld
WorkingDirectory=/home/lightworld/webapps/lightworldtech
ExecStart=/bin/bash /home/lightworld/shared/lightworldtech/ops/run-sms-dispatch.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
