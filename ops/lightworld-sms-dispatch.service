[Unit]
Description=Lightworld scheduled SMS dispatcher
After=network-online.target lightworldtech-app.service
Wants=network-online.target

[Service]
Type=oneshot
User=lightworldtechapp
Group=lightworldtechapp
WorkingDirectory=/home/lightworld/webapps/lightworldtech
ExecStart=/bin/bash /home/lightworld/shared/lightworldtech/ops/run-sms-dispatch.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
