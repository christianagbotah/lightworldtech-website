generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== CMS MODELS ====================

// Site-wide settings (hero, about, contact info, etc.)
model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  type  String @default("text") // text, richText, json, image
  group String @default("general") // general, hero, about, contact, social, seo

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Navigation menu items
model NavItem {
  id     String @id @default(cuid())
  label  String
  href   String @default("/")
  order  Int    @default(0)
  target String @default("_self") // _self, _blank
  active Boolean @default(true)
  parentId String?

  parent NavItem? @relation("NavSubItems", fields: [parentId], references: [id])
  children NavItem[] @relation("NavSubItems")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Services offered
model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  icon        String   @default("")
  image       String   @default("")
  features    String   @default("[]") // JSON array of feature strings
  order       Int      @default(0)
  active      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Team members
model TeamMember {
  id        String @id @default(cuid())
  name      String
  role      String
  bio       String  @default("")
  image     String  @default("")
  email     String  @default("")
  linkedin  String  @default("")
  twitter   String  @default("")
  order     Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Testimonials
model Testimonial {
  id       String @id @default(cuid())
  name     String
  company  String  @default("")
  role     String  @default("")
  content  String
  image    String  @default("")
  rating   Int     @default(5)
  active   Boolean @default(true)
  order    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Blog categories
model BlogCategory {
  id    String     @id @default(cuid())
  name  String
  slug  String     @unique
  description String @default("")

  posts BlogPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Blog posts
model BlogPost {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  excerpt     String        @default("")
  content     String        @default("")
  coverImage  String        @default("")
  author      String        @default("Lightworld Technologies")
  published   Boolean       @default(false)
  featured    Boolean       @default(false)
  readTime    Int           @default(5)

  categoryId  String?
  category    BlogCategory? @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Portfolio projects
model PortfolioProject {
  id          String  @id @default(cuid())
  title       String
  description String  @default("")
  image       String  @default("")
  url         String  @default("")
  category    String  @default("")
  technologies String @default("[]") // JSON array
  featured    Boolean @default(false)
  active      Boolean @default(true)
  order       Int     @default(0)

  caseStudyPublished         Boolean   @default(false)
  caseStudySlug              String?   @unique
  caseStudyClientName        String    @default("")
  caseStudyChallenge         String    @default("")
  caseStudySolution          String    @default("")
  caseStudyOutcomes          String    @default("")
  caseStudyApprovalReference String    @default("")
  caseStudyPublishedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Client logos / partners
model Client {
  id     String @id @default(cuid())
  name   String
  logo   String @default("")
  url    String @default("")
  order  Int    @default(0)
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Contact form submissions
model ContactMessage {
  id      String   @id @default(cuid())
  name    String
  email   String
  phone   String   @default("")
  subject String   @default("")
  message String
  read    Boolean               @default(false)
  lead    Lead?
  replies ContactMessageReply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessageReply {
  id               String         @id @default(cuid())
  contactMessageId String
  contactMessage   ContactMessage @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)
  authorAdminId    String         @default("")
  authorName       String         @default("")
  authorEmail      String         @default("")
  recipient        String
  subject          String
  body             String
  status           String         @default("sent")
  transport        String         @default("")
  error            String         @default("")
  sentAt           DateTime?

  createdAt DateTime @default(now())

  @@index([contactMessageId, createdAt])
  @@index([status, createdAt])
}

// Newsletter subscribers
model NewsletterSubscriber {
  id                 String                       @id @default(cuid())
  email              String                       @unique
  active             Boolean                      @default(true)
  deliveries         NewsletterDelivery[]
  campaignDeliveries NewsletterCampaignDelivery[]
  createdAt          DateTime                     @default(now())
}

// Delivery audit trail for newsletter confirmations and admin transport tests.
model NewsletterDelivery {
  id           String                @id @default(cuid())
  subscriberId String?
  subscriber   NewsletterSubscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  recipient    String
  kind         String                @default("confirmation")
  subject      String
  status       String
  transport    String                @default("")
  error        String                @default("")
  createdAt    DateTime              @default(now())

  @@index([status, createdAt])
  @@index([recipient, createdAt])
  @@index([subscriberId, createdAt])
}


model NewsletterCampaign {
  id         String                       @id @default(cuid())
  title      String
  subject    String
  preheader  String                       @default("")
  body       String
  ctaLabel   String                       @default("")
  ctaUrl     String                       @default("")
  status     String                       @default("draft")
  scheduledAt DateTime?
  sentAt     DateTime?
  deliveries NewsletterCampaignDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, updatedAt])
  @@index([status, scheduledAt])
}

model NewsletterCampaignDelivery {
  id           String               @id @default(cuid())
  campaignId   String
  campaign     NewsletterCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriberId String
  subscriber   NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  recipient    String
  status       String               @default("pending")
  transport    String               @default("")
  error        String               @default("")
  attempts     Int                  @default(0)
  sentAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, subscriberId])
  @@index([campaignId, status])
  @@index([subscriberId, createdAt])
}

// FAQ items
model FAQ {
  id       String @id @default(cuid())
  question String
  answer   String
  order    Int    @default(0)
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Development process steps (from services page)
model ProcessStep {
  id          String @id @default(cuid())
  title       String
  description String
  icon        String @default("")
  order       Int    @default(0)
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Admin user for CMS
model Admin {
  id        String          @id @default(cuid())
  email     String          @unique
  password  String
  name      String          @default("")
  role      String          @default("admin")
  active        Boolean         @default(true)
  recoveryEmail String          @default("")
  lastLogin     DateTime?
  authVersion       Int             @default(0)
  permissions       String          @default("[]")
  totpSecret        String          @default("")
  totpEnabled       Boolean         @default(false)
  totpRecoveryCodes String          @default("[]")
  auditLogs   AdminAuditLog[]
  resetTokens AdminPasswordResetToken[]
  agreementObligations ClientAgreementObligation[] @relation("AgreementObligationOwner")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminPasswordResetToken {
  id        String   @id @default(cuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([expiresAt])
}

model AdminAuditLog {
  id         String @id @default(cuid())
  adminId    String?
  admin      Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminEmail String @default("")
  adminName  String @default("")
  action     String
  entity     String @default("")
  entityId   String @default("")
  details    String @default("{}")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@index([entity, entityId])
}


// Privacy-conscious first-party product analytics.
// Deliberately stores no raw IP address, email address, or user-agent fingerprint.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  sessionId String
  event     String
  path      String   @default("/")
  referrer  String   @default("")
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([event, createdAt])
  @@index([sessionId, createdAt])
  @@index([path, createdAt])
}


// Corporate CRM record linked one-to-one with a website enquiry.
// Kept separate from ContactMessage so the original inbox remains intact.
model Lead {
  id               String         @id @default(cuid())
  contactMessageId String         @unique
  contactMessage   ContactMessage @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)
  status           String         @default("new")
  priority         String         @default("normal")
  assignedTo       String         @default("")
  source           String         @default("website")
  summary          String         @default("")
  tags             String         @default("[]")
  company          String         @default("")
  industry         String         @default("")
  countryRegion    String         @default("")
  timezone         String         @default("")
  serviceInterest  String         @default("")
  currency         String         @default("")
  budgetRange      String         @default("")
  deliveryWindow   String         @default("")
  engagementModel  String         @default("")
  international    Boolean        @default(false)
  expectedRevenue  Decimal        @default(0) @db.Decimal(18, 2)
  probability      Int            @default(10)
  nextAction       String         @default("")
  nextFollowUp     DateTime?
  lastContactedAt  DateTime?
  notes            LeadNote[]
  proposal         Proposal?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, updatedAt])
  @@index([priority, updatedAt])
  @@index([international, updatedAt])
  @@index([industry, updatedAt])
  @@index([countryRegion, updatedAt])
  @@index([nextFollowUp])
}

model LeadNote {
  id        String @id @default(cuid())
  leadId    String
  lead      Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  note      String
  author    String @default("Admin")
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}


// Human-reviewed proposal / discovery workspace linked one-to-one with a CRM lead.
model Proposal {
  id               String   @id @default(cuid())
  leadId           String   @unique
  lead             Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status           String   @default("draft")
  title            String
  executiveSummary String   @default("")
  solution         String   @default("")
  scope            String   @default("")
  deliverables     String   @default("[]")
  assumptions      String   @default("[]")
  timeline         String   @default("")
  commercialNotes  String   @default("")
  nextSteps        String   @default("")
  version          Int      @default(1)
  approvedBy       String   @default("")
  approvedAt       DateTime?
  sentAt           DateTime?
  lastGeneratedAt  DateTime?
  clientProject     ClientProject?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, updatedAt])
}


// Secure client portal models. Empty by default; admins create real organizations/accounts.
model ClientOrganization {
  id                 String             @id @default(cuid())
  name               String
  status             String             @default("active")
  primaryContactName String             @default("")
  primaryEmail       String             @default("")
  primaryPhone       String             @default("")
  paymentTermsDays   Int                @default(30)
  creditLimitCurrency String             @default("GHS")
  creditLimit        Decimal            @default(0) @db.Decimal(18, 2)
  creditHold         Boolean            @default(false)
  creditHoldReason   String             @default("")
  users              ClientPortalUser[]
  projects           ClientProject[]
  tickets            ClientSupportTicket[]
  announcements      ClientAnnouncement[]
  services           ClientServiceAccount[]
  invoices           ClientInvoice[]
  payments           ClientPayment[]
  paymentIntents     HubtelPaymentIntent[]
  creditNotes        FinanceCreditNote[]
  refunds            FinanceCustomerRefund[]
  collectionActivities FinanceCollectionActivity[]
  expenses           FinanceExpense[]
  agreements         ClientAgreement[]
  creditPolicyApprovals FinanceCreditPolicyApproval[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, updatedAt])
  @@index([name])
}

model ClientPortalUser {
  id             String             @id @default(cuid())
  organizationId String
  organization   ClientOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String             @unique
  password        String
  name            String
  role            String             @default("client_admin")
  active          Boolean            @default(true)
  lastLogin       DateTime?
  inviteTokenHash String              @default("")
  inviteExpiresAt DateTime?
  mustSetPassword Boolean             @default(true)
  authVersion     Int                 @default(0)
  resetTokens     ClientPasswordResetToken[]
  tickets         ClientSupportTicket[] @relation("ClientTicketCreator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, active])
}

model ClientPasswordResetToken {
  id        String           @id @default(cuid())
  userId    String
  user      ClientPortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model ClientProject {
  id             String             @id @default(cuid())
  organizationId String
  organization   ClientOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposalId     String?            @unique
  proposal       Proposal?          @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  name           String
  summary        String             @default("")
  status         String             @default("planned")
  health         String             @default("on_track")
  progress       Int                @default(0)
  manager        String             @default("")
  startDate         DateTime?
  targetDate        DateTime?
  expiryDate        DateTime?
  nextRenewalDate   DateTime?
  renewalCycle      String             @default("annual")
  renewalCurrency   String             @default("GHS")
  renewalAmount     Decimal            @default(0) @db.Decimal(18, 2)
  budgetCurrency    String             @default("GHS")
  budgetAmount      Decimal            @default(0) @db.Decimal(18, 2)
  autoRenew         Boolean            @default(false)
  renewalNoticeDays Int                @default(30)
  renewalNotes      String             @default("")
  milestones        ClientMilestone[]
  documents      ClientDocument[]
  announcements  ClientAnnouncement[]
  tickets        ClientSupportTicket[]
  services       ClientServiceAccount[]
  invoices       ClientInvoice[]
  expenses       FinanceExpense[]
  agreements     ClientAgreement[]
  purchaseRequests FinancePurchaseRequest[]
  purchaseOrders   FinancePurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([targetDate])
  @@index([expiryDate])
  @@index([nextRenewalDate])
}

model ClientAgreement {
  id                String             @id @default(cuid())
  organizationId    String
  organization      ClientOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId         String?
  project           ClientProject?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title             String
  agreementType     String             @default("contract")
  status            String             @default("draft")
  referenceNumber   String             @default("")
  currency          String             @default("GHS")
  contractValue     Decimal            @default(0) @db.Decimal(18, 2)
  contractValueBasis String            @default("unspecified")
  effectiveDate     DateTime?
  expiryDate        DateTime?
  renewalNoticeDays Int                @default(30)
  owner             String             @default("")
  documentUrl       String             @default("")
  notes             String             @default("")
  signedAt          DateTime?
  approvalStatus    String             @default("pending")
  approvalDecisionBy String            @default("")
  approvalDecisionAt DateTime?
  approvalNotes     String             @default("")
  attachments       ClientAgreementAttachment[]
  changes           ClientAgreementChange[]
  obligations       ClientAgreementObligation[]
  billingMilestones ClientAgreementBillingMilestone[]
  invoices          ClientInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([projectId])
  @@index([expiryDate])
}

model ClientAgreementBillingMilestone {
  id          String          @id @default(cuid())
  agreementId String
  agreement   ClientAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  title       String
  amount      Decimal         @db.Decimal(18, 2)
  dueDate     DateTime?
  order       Int             @default(0)
  notes       String          @default("")
  createdBy   String          @default("Admin")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agreementId, order])
  @@index([agreementId, dueDate])
}

model ClientAgreementChange {
  id          String          @id @default(cuid())
  agreementId String
  agreement   ClientAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  changedBy   String          @default("Admin")
  changeType  String          @default("update")
  fields      String          @default("")
  beforeState Json
  afterState  Json

  createdAt DateTime @default(now())

  @@index([agreementId, createdAt])
}

model ClientAgreementObligation {
  id          String          @id @default(cuid())
  agreementId String
  agreement   ClientAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  title       String
  category    String          @default("general")
  owner       String          @default("")
  ownerAdminId String?
  ownerAdmin   Admin?         @relation("AgreementObligationOwner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
  dueDate     DateTime?
  status      String          @default("open")
  notes       String          @default("")
  evidenceUrl String          @default("")
  completionSubmittedAt DateTime?
  completionSubmittedByAdminId String?
  completionSubmittedBy String @default("")
  completedAt DateTime?
  completedBy String          @default("")
  reviewedAt DateTime?
  reviewedByAdminId String?
  reviewedBy String           @default("")
  reviewNotes String           @default("")
  waiverReason String           @default("")
  waivedAt DateTime?
  waivedBy String               @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agreementId, status])
  @@index([ownerAdminId, status])
  @@index([dueDate])
}

model ClientAgreementAttachment {
  id           String          @id @default(cuid())
  agreementId  String
  agreement    ClientAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  originalName String
  storageName  String          @unique
  mimeType     String
  sizeBytes       Int
  uploadedBy      String          @default("Admin")
  visibleToClient Boolean         @default(false)

  createdAt DateTime @default(now())

  @@index([agreementId, createdAt])
  @@index([agreementId, visibleToClient, createdAt])
}

model ClientMilestone {
  id          String        @id @default(cuid())
  projectId   String
  project     ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String        @default("")
  status      String        @default("planned")
  order       Int           @default(0)
  dueDate     DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, order])
  @@index([dueDate])
}

model ClientSupportTicket {
  id                 String              @id @default(cuid())
  ticketNumber       String              @unique
  organizationId     String
  organization       ClientOrganization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId          String?
  project            ClientProject?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdById        String
  createdBy          ClientPortalUser    @relation("ClientTicketCreator", fields: [createdById], references: [id], onDelete: Cascade)
  subject            String
  message            String
  category           String              @default("general")
  status             String              @default("open")
  priority           String              @default("normal")
  assignedTo         String              @default("")
  firstResponseDueAt DateTime?
  resolutionDueAt    DateTime?
  firstRespondedAt   DateTime?
  resolvedAt         DateTime?
  escalatedAt        DateTime?
  lastActivityAt     DateTime            @default(now())
  unreadByAdmin      Boolean             @default(true)
  unreadByClient     Boolean             @default(false)
  clientRating       Int?
  clientFeedback     String              @default("")
  ratedAt            DateTime?
  messages           ClientTicketMessage[]
  internalNotes      ClientTicketInternalNote[]
  attachments        ClientTicketAttachment[]
  events             ClientTicketEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([projectId, status])
  @@index([createdById, createdAt])
  @@index([priority, status, updatedAt])
  @@index([assignedTo, status])
  @@index([firstResponseDueAt])
  @@index([resolutionDueAt])
  @@index([lastActivityAt])
}


model ClientDocument {
  id              String        @id @default(cuid())
  projectId       String
  project         ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String        @default("")
  url             String
  category        String        @default("document")
  visibleToClient Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, visibleToClient])
  @@index([createdAt])
}

model ClientTicketMessage {
  id         String              @id @default(cuid())
  ticketId   String
  ticket     ClientSupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType String              @default("admin")
  authorName String
  message    String

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

model ClientTicketInternalNote {
  id            String              @id @default(cuid())
  ticketId      String
  ticket        ClientSupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorAdminId String              @default("")
  authorName    String              @default("Admin")
  note          String

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

model ClientTicketAttachment {
  id             String              @id @default(cuid())
  ticketId       String
  ticket         ClientSupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  originalName   String
  storageName    String              @unique
  mimeType       String
  sizeBytes      Int
  uploadedByType String
  uploadedByName String

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

model ClientTicketEvent {
  id        String              @id @default(cuid())
  ticketId  String
  ticket    ClientSupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  type      String
  actorType String
  actorName String
  details   String              @default("{}")

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([type, createdAt])
}

model ClientServiceAccount {
  id                 String             @id @default(cuid())
  organizationId     String
  organization       ClientOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId          String?
  project            ClientProject?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name               String
  serviceType        String             @default("managed_service")
  planName           String             @default("")
  status             String             @default("active")
  billingCycle       String             @default("annual")
  currency           String             @default("GHS")
  recurringAmount    Decimal            @default(0) @db.Decimal(18, 2)
  startDate          DateTime
  expiryDate         DateTime?
  nextDueDate        DateTime?
  autoRenew          Boolean            @default(false)
  renewalNoticeDays  Int                @default(30)
  notes              String             @default("")
  changes            ClientServiceChange[]
  invoices           ClientInvoice[]
  expenses           FinanceExpense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([projectId])
  @@index([expiryDate])
  @@index([nextDueDate])
}

model ClientServiceChange {
  id             String               @id @default(cuid())
  serviceId      String
  service        ClientServiceAccount @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  changeType     String
  previousPlan   String               @default("")
  newPlan        String               @default("")
  previousAmount Decimal?             @db.Decimal(18, 2)
  newAmount      Decimal?             @db.Decimal(18, 2)
  effectiveAt        DateTime
  sourceInvoiceId     String?   @unique
  previousExpiryDate  DateTime?
  newExpiryDate       DateTime?
  previousNextDueDate DateTime?
  newNextDueDate      DateTime?
  previousStatus      String    @default("")
  newStatus           String    @default("")
  notes               String               @default("")
  changedBy      String               @default("Admin")

  createdAt DateTime @default(now())

  @@index([serviceId, effectiveAt])
  @@index([changeType, effectiveAt])
}

model ClientInvoice {
  id             String             @id @default(cuid())
  invoiceNumber  String             @unique
  organizationId String
  organization   ClientOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceId      String?
  service        ClientServiceAccount? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  projectId      String?
  project        ClientProject?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  agreementId    String?
  agreement      ClientAgreement?   @relation(fields: [agreementId], references: [id], onDelete: SetNull)
  status         String             @default("draft")
  currency       String             @default("GHS")
  issueDate      DateTime
  dueDate        DateTime
  renewalForDate     DateTime?
  renewalCompletedAt DateTime?
  renewalCompletedBy String             @default("")
  subtotal            Decimal            @db.Decimal(18, 2)
  discount       Decimal            @default(0) @db.Decimal(18, 2)
  tax            Decimal            @default(0) @db.Decimal(18, 2)
  taxTreatment   String             @default("legacy")
  taxableAmount  Decimal            @default(0) @db.Decimal(18, 2)
  vatRate        Decimal            @default(0) @db.Decimal(5, 2)
  vatAmount      Decimal            @default(0) @db.Decimal(18, 2)
  nhilRate       Decimal            @default(0) @db.Decimal(5, 2)
  nhilAmount     Decimal            @default(0) @db.Decimal(18, 2)
  getfundRate    Decimal            @default(0) @db.Decimal(5, 2)
  getfundAmount  Decimal            @default(0) @db.Decimal(18, 2)
  total          Decimal            @db.Decimal(18, 2)
  notes          String             @default("")
  createdBy      String             @default("Admin")
  lines          ClientInvoiceLine[]
  allocations    ClientPaymentAllocation[]
  paymentIntents  HubtelPaymentIntent[]
  creditNotes     FinanceCreditNote[]
  collectionActivities FinanceCollectionActivity[]
  accessLinks          InvoiceAccessLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([serviceId, dueDate])
  @@index([serviceId, renewalForDate])
  @@index([projectId])
  @@index([agreementId])
  @@index([dueDate, status])
  @@index([issueDate])
}

model InvoiceAccessLink {
  id            String        @id @default(cuid())
  invoiceId     String
  invoice       ClientInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tokenHash     String        @unique
  status        String        @default("active")
  expiresAt     DateTime
  createdBy     String        @default("Admin")
  sentTo        String        @default("")
  sentCount     Int           @default(0)
  lastSentAt    DateTime?
  firstViewedAt DateTime?
  lastViewedAt  DateTime?
  viewCount     Int           @default(0)
  revokedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId, status, expiresAt])
  @@index([status, expiresAt])
}

model ClientInvoiceLine {
  id          String        @id @default(cuid())
  invoiceId   String
  invoice     ClientInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal       @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal       @db.Decimal(18, 2)
  amount      Decimal       @db.Decimal(18, 2)
  order       Int           @default(0)

  createdAt DateTime @default(now())

  @@index([invoiceId, order])
}

model ClientPayment {
  id             String             @id @default(cuid())
  paymentNumber  String             @unique
  organizationId String
  organization   ClientOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  currency       String             @default("GHS")
  amount         Decimal            @db.Decimal(18, 2)
  paidAt         DateTime
  method            String             @default("bank_transfer")
  reference         String             @default("")
  source            String             @default("manual")
  providerReference String             @default("")
  notes             String             @default("")
  receivedBy                 String             @default("Admin")
  customerNotificationStatus  String             @default("pending")
  customerNotificationAttemptedAt DateTime?
  customerNotificationCompletedAt DateTime?
  customerNotificationChannels String             @default("")
  customerNotificationError    String             @default("")
  allocations                  ClientPaymentAllocation[]
  hubtelIntent      HubtelPaymentIntent?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, paidAt])
  @@index([paidAt])
}

model ClientPaymentAllocation {
  id        String        @id @default(cuid())
  paymentId String
  payment   ClientPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   ClientInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal       @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

model FinanceCollectionActivity {
  id             String             @id @default(cuid())
  organizationId String
  organization   ClientOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId      String
  invoice        ClientInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type           String
  note           String             @default("")
  promisedAmount Decimal?           @db.Decimal(18, 2)
  promisedDate   DateTime?
  nextFollowUpAt DateTime?
  completedAt    DateTime?
  smsMessageId   String             @default("")
  createdBy      String             @default("Admin")
  createdAt      DateTime           @default(now())

  @@index([invoiceId, createdAt])
  @@index([organizationId, createdAt])
  @@index([nextFollowUpAt, completedAt])
  @@index([type, createdAt])
}

model HubtelPaymentIntent {
  id                    String             @id @default(cuid())
  clientReference       String             @unique
  organizationId        String
  organization          ClientOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId             String
  invoice               ClientInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedPaymentId     String?            @unique
  recordedPayment       ClientPayment?     @relation(fields: [recordedPaymentId], references: [id], onDelete: SetNull)
  currency              String             @default("GHS")
  amount                Decimal            @db.Decimal(18, 2)
  payerName             String             @default("")
  payerEmail            String             @default("")
  payerPhone            String             @default("")
  status                String             @default("pending")
  checkoutId            String             @default("")
  checkoutUrl           String             @default("")
  checkoutDirectUrl     String             @default("")
  hubtelTransactionId   String             @default("")
  externalTransactionId String             @default("")
  paymentMethod         String             @default("")
  providerResponse      String             @default("{}")
  lastStatusCheckAt     DateTime?
  paidAt                DateTime?
  expiresAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([invoiceId, status])
  @@index([status, createdAt])
  @@index([hubtelTransactionId])
}

model SmsTemplate {
  id          String        @id @default(cuid())
  name        String
  key         String        @unique
  category    String        @default("general")
  body        String
  variables   String        @default("[]")
  active      Boolean       @default(true)
  system      Boolean       @default(false)
  campaigns   SmsCampaign[]
  messages    SmsMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, category])
  @@index([name])
}

model SmsCampaign {
  id             String                 @id @default(cuid())
  name           String
  templateId     String?
  template       SmsTemplate?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  senderId       String                 @default("")
  body           String
  status         String                 @default("draft")
  audienceType   String                 @default("manual")
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  recipientCount Int                    @default(0)
  sentCount      Int                    @default(0)
  failedCount    Int                    @default(0)
  createdBy      String                 @default("Admin")
  recipients     SmsCampaignRecipient[]
  messages       SmsMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledAt])
  @@index([templateId])
  @@index([createdAt])
}

model SmsCampaignRecipient {
  id        String      @id @default(cuid())
  campaignId String
  campaign  SmsCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  phone     String
  name      String      @default("")
  variables String      @default("{}")
  status    String      @default("pending")
  attempts  Int         @default(0)
  error     String      @default("")
  sentAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, phone])
  @@index([campaignId, status])
}

model SmsMessage {
  id                String       @id @default(cuid())
  templateId        String?
  template          SmsTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  campaignId        String?
  campaign          SmsCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  recipient         String
  senderId          String
  content           String
  clientReference   String       @unique
  status            String       @default("queued")
  providerMessageId String       @default("")
  networkId         String       @default("")
  rate              Decimal?     @db.Decimal(18, 4)
  error             String       @default("")
  scheduledAt       DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  createdBy         String       @default("Admin")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId, status])
  @@index([recipient, createdAt])
  @@index([status, scheduledAt])
  @@index([providerMessageId])
}

model FinanceVendor {
  id        String              @id @default(cuid())
  name      String
  email     String              @default("")
  phone     String              @default("")
  taxId     String              @default("")
  active    Boolean             @default(true)
  paymentTermsDays Int          @default(30)
  notes     String              @default("")
  bills     FinanceVendorBill[]
  payments  FinanceVendorPayment[]
  expenses  FinanceExpense[]
  purchaseRequests FinancePurchaseRequest[]
  purchaseOrders   FinancePurchaseOrder[]
  supplierQuotes   FinanceSupplierQuote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([active])
}

model FinanceVendorBill {
  id             String              @id @default(cuid())
  payableNumber  String              @unique
  vendorId       String
  vendor         FinanceVendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  vendorReference String             @default("")
  category       String              @default("operating_expense")
  status         String              @default("unpaid")
  currency       String              @default("GHS")
  issueDate      DateTime
  dueDate        DateTime
  taxTreatment   String              @default("legacy")
  taxRecoverable Boolean             @default(true)
  taxableAmount  Decimal             @default(0) @db.Decimal(18, 2)
  vatRate        Decimal             @default(0) @db.Decimal(5, 2)
  vatAmount      Decimal             @default(0) @db.Decimal(18, 2)
  nhilRate       Decimal             @default(0) @db.Decimal(5, 2)
  nhilAmount     Decimal             @default(0) @db.Decimal(18, 2)
  getfundRate    Decimal             @default(0) @db.Decimal(5, 2)
  getfundAmount  Decimal             @default(0) @db.Decimal(18, 2)
  total          Decimal             @db.Decimal(18, 2)
  notes          String              @default("")
  purchaseOrderId String?             @unique
  purchaseOrder   FinancePurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  allocations    FinanceVendorPaymentAllocation[]
  attachments    FinanceVendorBillAttachment[]
  treasuryLines  FinanceTreasuryPaymentRunLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId, status])
  @@index([dueDate, status])
  @@index([issueDate])
}

model FinanceVendorBillAttachment {
  id           String            @id @default(cuid())
  billId       String
  bill         FinanceVendorBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  originalName String
  storageName  String            @unique
  mimeType     String
  sizeBytes    Int
  uploadedBy   String            @default("Admin")

  createdAt DateTime @default(now())

  @@index([billId, createdAt])
}

model FinanceVendorPayment {
  id            String              @id @default(cuid())
  paymentNumber String              @unique
  vendorId      String
  vendor        FinanceVendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  currency      String              @default("GHS")
  amount        Decimal             @db.Decimal(18, 2)
  paidAt        DateTime
  method        String              @default("bank_transfer")
  reference     String              @default("")
  notes         String              @default("")
  paidBy        String              @default("Admin")
  allocations   FinanceVendorPaymentAllocation[]
  attachments   FinanceVendorPaymentAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId, paidAt])
  @@index([paidAt])
}

model FinanceVendorPaymentAttachment {
  id           String               @id @default(cuid())
  paymentId    String
  payment      FinanceVendorPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  originalName String
  storageName  String               @unique
  mimeType     String
  sizeBytes    Int
  uploadedBy   String               @default("Admin")

  createdAt DateTime @default(now())

  @@index([paymentId, createdAt])
}

model FinanceVendorPaymentAllocation {
  id        String               @id @default(cuid())
  paymentId String
  payment   FinanceVendorPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  billId    String
  bill      FinanceVendorBill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount    Decimal              @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  @@unique([paymentId, billId])
  @@index([billId])
}

model FinanceExpense {
  id             String                @id @default(cuid())
  expenseNumber  String                @unique
  vendorId       String?
  vendor         FinanceVendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   ClientOrganization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  projectId      String?
  project        ClientProject?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  serviceId      String?
  service        ClientServiceAccount? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  category      String         @default("operating_expense")
  description   String
  currency      String         @default("GHS")
  amount        Decimal        @db.Decimal(18, 2)
  incurredAt    DateTime
  paidAt        DateTime?
  method        String         @default("")
  reference     String         @default("")
  notes         String         @default("")
  recordedBy    String         @default("Admin")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId, incurredAt])
  @@index([organizationId, incurredAt])
  @@index([projectId, incurredAt])
  @@index([serviceId, incurredAt])
  @@index([category, incurredAt])
  @@index([paidAt])
}

model FinancePurchaseRequest {
  id                 String                       @id @default(cuid())
  requestNumber      String                       @unique
  title              String
  description        String                       @default("")
  vendorId           String?
  vendor             FinanceVendor?               @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  projectId          String?
  project            ClientProject?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  currency           String                       @default("GHS")
  estimatedAmount    Decimal                      @default(0) @db.Decimal(18, 2)
  neededBy           DateTime?
  status             String                       @default("submitted")
  requestedByAdminId String
  requestedByName    String                       @default("")
  submittedAt        DateTime                     @default(now())
  decidedByAdminId   String                       @default("")
  decidedByName      String                       @default("")
  decidedAt          DateTime?
  decisionNotes      String                       @default("")
  convertedAt        DateTime?
  lines              FinancePurchaseRequestLine[]
  purchaseOrder      FinancePurchaseOrder?
  supplierQuotes     FinanceSupplierQuote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, submittedAt])
  @@index([vendorId, status])
  @@index([projectId, status])
}

model FinancePurchaseRequestLine {
  id          String                 @id @default(cuid())
  requestId   String
  request     FinancePurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal                @db.Decimal(12, 3)
  unitPrice   Decimal                @db.Decimal(18, 2)
  amount      Decimal                @db.Decimal(18, 2)
  receiptLines FinancePurchaseReceiptLine[]

  createdAt DateTime @default(now())

  @@index([requestId])
}

model FinanceSupplierQuote {
  id             String                 @id @default(cuid())
  requestId      String
  request        FinancePurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  vendorId       String
  vendor         FinanceVendor          @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  quoteReference String                 @default("")
  currency       String                 @default("GHS")
  total          Decimal                @db.Decimal(18, 2)
  leadTimeDays   Int?
  validUntil     DateTime?
  notes          String                 @default("")
  selected       Boolean                @default(false)
  selectedAt     DateTime?
  selectedById   String                 @default("")
  selectedByName String                 @default("")
  selectionReason String                @default("")
  attachments    FinanceSupplierQuoteAttachment[]
  createdById    String
  createdByName  String                 @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId, selected])
  @@index([vendorId, createdAt])
  @@index([validUntil])
}

model FinanceSupplierQuoteAttachment {
  id           String               @id @default(cuid())
  quoteId      String
  quote        FinanceSupplierQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  originalName String
  storageName  String               @unique
  mimeType     String
  sizeBytes    Int
  uploadedById String               @default("")
  uploadedByName String             @default("")

  createdAt DateTime @default(now())

  @@index([quoteId, createdAt])
}

model FinancePurchaseOrder {
  id           String                 @id @default(cuid())
  poNumber     String                 @unique
  requestId    String?                @unique
  request      FinancePurchaseRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  vendorId     String
  vendor       FinanceVendor          @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  projectId    String?
  project      ClientProject?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  currency     String                 @default("GHS")
  total        Decimal                @db.Decimal(18, 2)
  issueDate    DateTime               @default(now())
  expectedDate DateTime?
  status       String                 @default("issued")
  notes        String                 @default("")
  issuedBy     String                 @default("Admin")
  receivedAt   DateTime?
  receivedBy   String                 @default("")
  closedAt     DateTime?
  closedBy     String                 @default("")
  bill         FinanceVendorBill?
  receipts     FinancePurchaseReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId, status])
  @@index([projectId, status])
  @@index([status, expectedDate])
}

model FinancePurchaseReceipt {
  id          String                     @id @default(cuid())
  receiptNumber String                   @unique
  purchaseOrderId String
  purchaseOrder FinancePurchaseOrder     @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  notes       String                     @default("")
  receivedByAdminId String
  receivedByName String                  @default("")
  receivedAt  DateTime                   @default(now())
  lines       FinancePurchaseReceiptLine[]

  createdAt DateTime @default(now())

  @@index([purchaseOrderId, receivedAt])
}

model FinancePurchaseReceiptLine {
  id            String                     @id @default(cuid())
  receiptId     String
  receipt       FinancePurchaseReceipt     @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  requestLineId     String
  requestLine       FinancePurchaseRequestLine @relation(fields: [requestLineId], references: [id], onDelete: Restrict)
  quantity          Decimal                    @db.Decimal(12, 3)
  rejectedQuantity  Decimal                    @default(0) @db.Decimal(12, 3)
  inspectionNotes   String                     @default("")

  createdAt DateTime @default(now())

  @@index([receiptId])
  @@index([requestLineId])
}

model FinanceTaxProfile {
  id                    String   @id
  countryCode           String   @default("GH")
  enabled               Boolean  @default(false)
  vatRegistrationNumber String   @default("")
  vatRate               Decimal  @default(15) @db.Decimal(5, 2)
  nhilRate              Decimal  @default(2.5) @db.Decimal(5, 2)
  getfundRate           Decimal  @default(2.5) @db.Decimal(5, 2)
  effectiveFrom         DateTime @default(dbgenerated("'2026-01-01 00:00:00'::timestamp without time zone"))
  updatedBy             String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FinanceAccount {
  id           String               @id @default(cuid())
  code         String               @unique
  name         String
  type         String
  subtype      String               @default("")
  systemKey    String?              @unique
  description  String               @default("")
  active       Boolean              @default(true)
  allowPosting Boolean              @default(true)
  parentId     String?
  parent       FinanceAccount?      @relation("FinanceAccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     FinanceAccount[]     @relation("FinanceAccountHierarchy")
  journalLines FinanceJournalLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, active])
  @@index([parentId])
}

model FinanceAccountingPeriod {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  status    String   @default("open")
  closedAt  DateTime?
  closedBy  String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([startDate, endDate])
  @@index([status, startDate, endDate])
}

model FinanceApprovalPolicy {
  id                    String   @id
  enabled               Boolean  @default(false)
  requireSecondApprover Boolean  @default(true)
  updatedBy             String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FinanceOutflowApproval {
  id                 String   @id @default(cuid())
  requestNumber      String   @unique
  outflowType        String
  status             String   @default("pending")
  counterpartyId     String   @default("")
  counterpartyName   String   @default("")
  sourceId           String   @default("")
  sourceReference    String   @default("")
  currency           String   @default("GHS")
  amount             Decimal  @db.Decimal(18, 2)
  effectiveDate      DateTime
  method             String   @default("bank_transfer")
  reference          String   @default("")
  reason             String   @default("")
  allocationsJson    String   @default("[]")
  requestedByAdminId String
  requestedByName    String   @default("")
  requestedByEmail   String   @default("")
  requestedAt        DateTime @default(now())
  decidedByAdminId   String   @default("")
  decidedByName      String   @default("")
  decidedByEmail     String   @default("")
  decidedAt          DateTime?
  decisionNotes      String   @default("")
  resultId           String   @default("")
  resultNumber       String   @default("")
  attachments        FinanceOutflowApprovalAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, requestedAt])
  @@index([outflowType, status])
  @@index([counterpartyId, status])
  @@index([sourceId, status])
  @@index([requestedByAdminId, status])
}


model FinanceTreasuryPaymentRun {
  id                 String                          @id @default(cuid())
  runNumber          String                          @unique
  status             String                          @default("draft")
  currency           String                          @default("GHS")
  plannedDate        DateTime
  dueThrough         DateTime
  sourceSystemKey    String
  sourceLabel        String
  sourceReference    String                          @default("")
  notes              String                          @default("")
  preparedByAdminId  String
  preparedByName     String                          @default("")
  preparedByEmail    String                          @default("")
  submittedByAdminId String                          @default("")
  submittedByName    String                          @default("")
  submittedByEmail   String                          @default("")
  submittedAt        DateTime?
  lines              FinanceTreasuryPaymentRunLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, plannedDate])
  @@index([currency, dueThrough])
  @@index([preparedByAdminId, status])
}

model FinanceTreasuryPaymentRunLine {
  id             String                    @id @default(cuid())
  runId          String
  run            FinanceTreasuryPaymentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  billId         String
  bill           FinanceVendorBill         @relation(fields: [billId], references: [id], onDelete: Restrict)
  vendorId       String
  vendorName     String
  payableNumber  String
  dueDate        DateTime
  amount         Decimal                   @db.Decimal(18, 2)
  status         String                    @default("planned")
  approvalId     String                    @default("")
  paymentId      String                    @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([runId, billId])
  @@index([billId, status])
  @@index([vendorId, status])
  @@index([approvalId])
}

model FinanceOutflowApprovalAttachment {
  id           String                 @id @default(cuid())
  approvalId   String
  approval     FinanceOutflowApproval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  originalName String
  storageName  String                 @unique
  mimeType     String
  sizeBytes    Int
  uploadedBy   String                 @default("Admin")

  createdAt DateTime @default(now())

  @@index([approvalId, createdAt])
}

model FinanceCreditPolicyApproval {
  id                    String             @id @default(cuid())
  organizationId        String
  organization          ClientOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status                String             @default("pending")
  paymentTermsDays      Int
  creditLimitCurrency   String
  creditLimit           Decimal            @db.Decimal(18, 2)
  creditHold            Boolean
  creditHoldReason      String             @default("")
  previousPolicyJson    String             @default("{}")
  requestedByAdminId    String
  requestedByName       String             @default("")
  requestedByEmail      String             @default("")
  requestedAt           DateTime           @default(now())
  decidedByAdminId      String             @default("")
  decidedByName         String             @default("")
  decidedByEmail        String             @default("")
  decidedAt             DateTime?
  decisionNotes         String             @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status, requestedAt])
  @@index([status, requestedAt])
  @@index([requestedByAdminId, status])
}

model FinanceMonthClose {
  id        String   @id @default(cuid())
  monthStart DateTime @unique
  monthEnd   DateTime
  status     String   @default("open")
  closedAt   DateTime?
  closedBy   String   @default("")
  reopenedAt DateTime?
  reopenedBy String   @default("")
  notes      String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, monthStart])
}

model FinanceJournalEntry {
  id            String               @id @default(cuid())
  journalNumber String               @unique
  entryDate     DateTime
  currency      String               @default("GHS")
  description   String
  reference     String               @default("")
  sourceType    String               @default("manual")
  sourceId      String               @default("")
  status        String               @default("posted")
  postedAt      DateTime             @default(now())
  postedBy      String               @default("Admin")
  lines         FinanceJournalLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entryDate, status])
  @@index([currency, entryDate])
  @@index([sourceType, sourceId])
}

model FinanceJournalLine {
  id          String              @id @default(cuid())
  entryId     String
  entry       FinanceJournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId   String
  account     FinanceAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  description String              @default("")
  debit       Decimal             @default(0) @db.Decimal(18, 2)
  credit      Decimal             @default(0) @db.Decimal(18, 2)

  reconciliationLine FinanceReconciliationLine?

  createdAt DateTime @default(now())

  @@index([entryId])
  @@index([accountId, createdAt])
}

model FinanceCreditNote {
  id               String             @id @default(cuid())
  creditNoteNumber String             @unique
  organizationId   String
  organization     ClientOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoiceId        String
  invoice          ClientInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  currency         String             @default("GHS")
  issueDate        DateTime
  reason           String
  subtotal         Decimal            @db.Decimal(18, 2)
  tax              Decimal            @default(0) @db.Decimal(18, 2)
  vatAmount        Decimal            @default(0) @db.Decimal(18, 2)
  nhilAmount       Decimal            @default(0) @db.Decimal(18, 2)
  getfundAmount    Decimal            @default(0) @db.Decimal(18, 2)
  total            Decimal            @db.Decimal(18, 2)
  appliedAmount    Decimal            @default(0) @db.Decimal(18, 2)
  status           String             @default("posted")
  createdBy        String             @default("Admin")
  refunds          FinanceCustomerRefund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, issueDate])
  @@index([invoiceId, status])
}

model FinanceCustomerRefund {
  id             String             @id @default(cuid())
  refundNumber   String             @unique
  organizationId String
  organization   ClientOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  creditNoteId   String
  creditNote     FinanceCreditNote  @relation(fields: [creditNoteId], references: [id], onDelete: Restrict)
  currency       String             @default("GHS")
  amount         Decimal            @db.Decimal(18, 2)
  refundedAt     DateTime
  method         String             @default("bank_transfer")
  reference      String             @default("")
  reason         String             @default("")
  refundedBy     String             @default("Admin")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, refundedAt])
  @@index([creditNoteId, refundedAt])
}

model FinanceReconciliationBatch {
  id               String                      @id @default(cuid())
  batchNumber      String                      @unique
  channel          String
  accountSystemKey String
  accountLabel     String
  accountReference String                      @default("")
  currency         String                      @default("GHS")
  statementFrom    DateTime
  statementTo      DateTime
  openingBalance   Decimal                     @db.Decimal(18, 2)
  closingBalance   Decimal                     @db.Decimal(18, 2)
  status           String                      @default("open")
  importedBy       String                      @default("Admin")
  reconciledAt     DateTime?
  reconciledBy     String                      @default("")
  notes            String                      @default("")
  lines            FinanceReconciliationLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountSystemKey, currency, statementTo])
  @@index([status, statementTo])
}

model FinanceReconciliationLine {
  id                   String                     @id @default(cuid())
  batchId              String
  batch                FinanceReconciliationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  transactionDate      DateTime
  description          String
  reference            String                     @default("")
  direction            String
  amount               Decimal                    @db.Decimal(18, 2)
  status               String                     @default("unmatched")
  matchedJournalLineId String?                    @unique
  matchedJournalLine   FinanceJournalLine?        @relation(fields: [matchedJournalLineId], references: [id], onDelete: SetNull)
  matchedAt            DateTime?
  matchedBy            String                     @default("")
  notes                String                     @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchId, status])
  @@index([transactionDate, amount])
}

model ClientAnnouncement {
  id             String             @id @default(cuid())
  organizationId String
  organization   ClientOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        ClientProject?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String
  body           String
  active         Boolean            @default(true)
  publishAt      DateTime            @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, active, publishAt])
  @@index([projectId, active, publishAt])
}


model AutomationRuntimeState {
  id                  String   @id
  status              String   @default("unknown")
  lastStartedAt       DateTime?
  lastCompletedAt     DateTime?
  lastSuccessAt       DateTime?
  durationMs          Int      @default(0)
  consecutiveFailures Int      @default(0)
  lastError           String   @default("")
  resultJson          String   @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}